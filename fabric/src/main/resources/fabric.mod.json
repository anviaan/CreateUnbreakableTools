{
  "schemaVersion": 1,
  "id": "create_unbreakable",
  "version": "${version}",
  "name": "Create Unbreakable Tools Mod",
  "description": "This is an addon mod for Create in Fabric that provides the ability to make your tools unbreakable.",
  "authors": [
    "anvian"
  ],
  "contributors": [
    "PinhaColada2222",
    "awadito2"
  ],
  "contact": {
    "sources": "https://github.com/anviaan/CreateUnbreakableTools",
    "issues": "https://github.com/anviaan/CreateUnbreakableTools/issues",
    "homepage": "https://modrinth.com/mod/create_unbreakable"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/create-unbreakable-tools",
        "modmenu.modrinth": "https://modrinth.com/mod/create_unbreakable"
      }
    }
  },
  "license": "GPL-3.0",
  "icon": "assets/create_unbreakable/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.anvian.create_unbreakable.fabric.CreateUnbreakableToolsFabric"
    ]
  },
  "mixins": [
    "create_unbreakable.mixins.json",
    "create_unbreakable-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": ">=${create_version}",
    "anvianslib": ">=1.1"
  }
}